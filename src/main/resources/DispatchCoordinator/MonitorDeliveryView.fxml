                  <Label fx:id="orderIdLabel" layoutX="23.0" layoutY="341.0" prefHeight="18.0" prefWidth="206.0" text="Order ID" />
                  <Label fx:id="truckIdLabel" layoutX="23.0" layoutY="377.0" prefHeight="18.0" prefWidth="166.0" text="Truck ID" />
                  <Label fx:id="driverNameLabel" layoutX="23.0" layoutY="409.0" prefHeight="18.0" prefWidth="185.0" text="Driver Name" />
