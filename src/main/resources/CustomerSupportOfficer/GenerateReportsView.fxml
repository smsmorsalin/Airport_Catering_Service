                                <TextField fx:id="airlineTextField" layoutX="160" layoutY="125" prefWidth="220" />







                                <Label layoutX="420" layoutY="80" text="Date Range" />



                                <ComboBox fx:id="dateRangeComboBox" layoutX="520" layoutY="75" prefWidth="150" />






                                <Label layoutX="420" layoutY="130" text="Status" />



                                <ComboBox fx:id="statusComboBox" layoutX="520" layoutY="125" prefWidth="150" />





                            </children>


                        </AnchorPane>









                        <!-- REPORT TYPES -->


                        <AnchorPane layoutX="6" layoutY="390" prefHeight="180" prefWidth="350" style="-fx-background-color:#EAF2FF;             -fx-background-radius:25;">


                            <children>



                                <Label layoutX="20" layoutY="20" text="Available Reports">


                                    <font>
                                        <Font size="20" />
                                    </font>


                                </Label>




                                <Label layoutX="30" layoutY="70" text="✓ Cost Report" />


                                <Label layoutX="30" layoutY="100" text="✓ Invoice Report" />


                                <Label layoutX="30" layoutY="130" text="✓ Payment Report" />


                                <Label layoutX="180" layoutY="70" text="✓ Complaint Report" />


                                <Label layoutX="180" layoutY="100" text="✓ Performance Report" />




                            </children>


                        </AnchorPane>









                        <!-- REPORT SUMMARY -->


                        <AnchorPane layoutX="385" layoutY="390" prefHeight="180" prefWidth="333" style="-fx-background-color:white;             -fx-background-radius:25;">


                            <children>



                                <Label layoutX="20" layoutY="20" text="Report Summary">


                                    <font>
                                        <Font size="20" />
                                    </font>


                                </Label>




                                <Label layoutX="25" layoutY="75" text="Generated Report:" />


                                <Label fx:id="generatedReportLabel" layoutX="170" layoutY="75" text="None" />





                                <Label layoutX="25" layoutY="115" text="Status:" />


                                <Label fx:id="reportStatusLabel" layoutX="170" layoutY="115" text="Ready" />




                            </children>


                        </AnchorPane>










                        <!-- BUTTONS -->


                        <Button fx:id="generateReportBtn" layoutX="110" layoutY="620" onAction="#GenerateReportOnAction" prefHeight="40" prefWidth="170" style="-fx-background-color:#0F6BFF;         -fx-text-fill:white;         -fx-background-radius:10;" text="Generate Report">


                            <font>
                                <Font size="14" />
                            </font>


                        </Button>





                        <Button fx:id="exportPdfBtn" layoutX="300" layoutY="620" onAction="#ExportPDFOnAction" prefHeight="40" prefWidth="140" style="-fx-background-color:green;         -fx-text-fill:white;         -fx-background-radius:10;" text="Export PDF">


                            <font>
                                <Font size="14" />
                            </font>


                        </Button>





                        <Button layoutX="470" layoutY="620" onAction="#ResetOnAction" prefHeight="40" prefWidth="120" style="-fx-background-radius:10;" text="Reset" />





                    </children>


