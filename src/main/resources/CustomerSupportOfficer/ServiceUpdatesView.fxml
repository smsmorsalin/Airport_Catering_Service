<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="758.0" prefWidth="898.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.airport_catering_service.controller.customer_support_officer.ServiceUpdatesViewController">


    <children>

        <VBox layoutY="49.0" prefHeight="706.0" prefWidth="175.0" spacing="5">

            <children>
                <Button onAction="#sidebardashboardButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Dashboard">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sidebarRegisterComplaintButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Register Complaint">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sidebarTrackComplaintButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Track Complaint">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sidebarResolveComplaintButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Resolve Complaint">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sidebarEmergencyModificationButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Emergency Modification">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sidebarFlightDelayRequestButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Flight Delay Request">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sidebarFlightCancellationButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Flight Cancellation">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sidebarServiceUpdatesButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;         -fx-background-color:#0F6BFF;" text="Service Updates" textFill="white">

                    <font>
                        <Font size="15" />
                    </font>

                </Button>
                <Button onAction="#sidebarGenerateReportsButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Generate Reports">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
            </children>
        </VBox>

        <Button layoutY="3" onAction="#sidebarHomePageOnAction" prefHeight="29" prefWidth="175" style="-fx-background-color:pink;         -fx-background-radius:5;" text="Airport Catering Service">
            <font>
                <Font name="Arial Bold" size="13" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
        <VBox layoutX="175" prefHeight="758" prefWidth="726" style="-fx-background-color:silver;">
            <children>
                <Label alignment="CENTER" prefWidth="609" text="welcome Username">
                    <font>
                        <Font name="Gabriola" size="18" />
                    </font>
                </Label>
                <AnchorPane prefHeight="734" prefWidth="726" style="-fx-background-color:white;">
                    <children>
                        <Label layoutX="56" layoutY="25" text="Service Updates">
                            <font>
                                <Font size="24" />
                            </font>
                        </Label>
                        <Label layoutX="56" layoutY="65" text="Create and manage catering service announcements" />
                        <AnchorPane layoutX="6" layoutY="105" prefHeight="430" prefWidth="420" style="-fx-background-color:white;             -fx-background-radius:25;">
                            <children>
                                <Label layoutX="25" layoutY="25" text="Create Service Update">
                                    <font>
                                        <Font size="20" />
                                    </font>
                                </Label>
                                <Label layoutX="25" layoutY="80" text="Update Category" />
                                <ComboBox fx:id="updateCategoryComboBox" layoutX="170" layoutY="75" prefWidth="210" />
