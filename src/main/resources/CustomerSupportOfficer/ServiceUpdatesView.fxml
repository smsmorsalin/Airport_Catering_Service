                                <Label layoutX="25" layoutY="330" text="Priority" />
                                <ComboBox fx:id="priorityComboBox" layoutX="170" layoutY="325" prefWidth="210" />
                                <Button fx:id="publishUpdateBtn" layoutX="110" layoutY="380" onAction="#PublishUpdateOnAction" prefHeight="40" prefWidth="170" style="-fx-background-color:#0F6BFF;         -fx-text-fill:white;         -fx-background-radius:10;" text="Publish Update">
                                    <font>
                                        <Font size="14" />
                                    </font>
                                </Button>
                            </children>
                        </AnchorPane>
                        <AnchorPane layoutX="438.0" layoutY="105.0" prefHeight="430" prefWidth="273" style="-fx-background-color:#EAF2FF;             -fx-background-radius:25;">
                            <children>
                                <Label layoutX="20" layoutY="25" text="Update Summary">
                                    <font>
                                        <Font size="20" />
                                    </font>
                                </Label>
                                <Label layoutX="25" layoutY="90" text="Category" />
                                <Label fx:id="summaryCategoryLabel" layoutX="130" layoutY="90" text="-" />
                                <Label layoutX="25" layoutY="140" text="Priority" />
                                <Label fx:id="summaryPriorityLabel" layoutX="130" layoutY="140" text="-" />
                                <Label layoutX="25" layoutY="190" text="Status" />
                                <Label fx:id="updateStatusLabel" layoutX="130" layoutY="190" text="Draft" />
                                <Button fx:id="viewUpdatesBtn" layoutX="55" layoutY="300" onAction="#ViewUpdatesLabel" prefHeight="40" prefWidth="160" style="-fx-background-radius:10;" text="View Updates" />

                            </children>
                        </AnchorPane>
                        <AnchorPane layoutX="6" layoutY="570" prefHeight="100" prefWidth="712" style="-fx-background-color:#F8FAFC;             -fx-background-radius:20;">
                            <children>
                                <Label layoutX="25" layoutY="20" text="Recent Service Updates">
                                    <font>
                                        <Font size="18" />
                                    </font>
                                </Label>
                                <Label fx:id="recentUpdatesLabel" layoutX="25" layoutY="55" text="No recent updates available" />
                            </children>
                        </AnchorPane>
                    </children>
                </AnchorPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
