                        <Font name="Gabriola" size="18" />
                    </font>

                </Label>







                <AnchorPane prefHeight="734" prefWidth="716" style="-fx-background-color:white;">


                    <children>



                        <Label layoutX="56" layoutY="29" text="Register Complaint">


                            <font>
                                <Font size="24" />
                            </font>

                        </Label>




                        <Label layoutX="56" layoutY="70" text="Register a new customer complaint" />







                        <AnchorPane layoutX="38" layoutY="97" prefHeight="584" prefWidth="634" style="-fx-background-color:#F8FAFC;             -fx-background-radius:25;">


                            <children>




                                <Label layoutX="28" layoutY="29" text="Complaint Information">


                                    <font>
                                        <Font size="20" />
