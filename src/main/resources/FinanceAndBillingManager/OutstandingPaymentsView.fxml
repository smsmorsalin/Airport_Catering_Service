<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="758.0" prefWidth="898.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.airport_catering_service.controller.finance_and_billing_manager.OutstandingPaymentsViewController">


    <children>


        <!-- ================= SIDEBAR ================= -->


        <VBox layoutY="49" prefHeight="706" prefWidth="175" spacing="5">


            <children>


                <Button prefHeight="46" prefWidth="174" style="-fx-background-radius:50;" text="Dashboard" />


                <Button prefHeight="46" prefWidth="174" style="-fx-background-radius:50;" text="Calculate Cost" />


                <Button prefHeight="46" prefWidth="174" style="-fx-background-radius:50;" text="Generate Invoice" />


                <Button prefHeight="46" prefWidth="174" style="-fx-background-radius:50;" text="Record Payment" />


                <Button prefHeight="46" prefWidth="174" style="-fx-background-radius:50;" text="Process Refund" />


                <Button onAction="#sidebarOutstandingPaymentOnAction" prefHeight="46" prefWidth="174" style="-fx-background-color:#F39C12;                -fx-background-radius:50;" text="Outstanding Payments" textFill="WHITE" />


                <Button prefHeight="46" prefWidth="174" style="-fx-background-radius:50;" text="Financial Reports" />


                <Button prefHeight="46" prefWidth="174" style="-fx-background-radius:50;" text="Revenue Summary" />


                <Button prefHeight="46" prefWidth="174" style="-fx-background-radius:50;" text="Payment History" />


            </children>

        </VBox>





        <!-- HEADER -->


        <Button layoutY="3" prefHeight="29" prefWidth="175" style="-fx-background-color:#C0007F;                -fx-background-radius:5;" text="Airport Catering Service">


            <font>
                <Font name="Arial Bold" size="13" />
            </font>


            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>


        </Button>







        <!-- MAIN AREA -->


        <VBox layoutX="175" prefHeight="758" prefWidth="726" style="-fx-background-color:#B5B5B5;">


            <children>


                <Label alignment="CENTER" prefWidth="726" text="welcome Username">


                    <font>
                        <Font name="Gabriola" size="18" />
                    </font>


                </Label>






                <AnchorPane prefHeight="734" prefWidth="726" style="-fx-background-color:white;">


                    <children>





                        <!-- SEARCH FILTER CARD -->


                        <AnchorPane layoutX="15" layoutY="20" prefHeight="120" prefWidth="680" style="-fx-background-color:#F8FAFC;                    -fx-background-radius:25;">


                            <children>


                                <Label layoutX="25" layoutY="25" text="Outstanding Payments">


                                    <font>
                                        <Font size="22" />
                                    </font>


                                </Label>




                                <Label layoutX="30" layoutY="75" text="Invoice Status" />


                                <ComboBox fx:id="invoiceStatusComboBox" layoutX="130" layoutY="70" prefWidth="150" />




                                <Label layoutX="320" layoutY="75" text="Date Range" />


                                <DatePicker fx:id="startDatePicker" layoutX="390" layoutY="70" prefWidth="110" />



                                <DatePicker fx:id="endDatePicker" layoutX="510" layoutY="70" prefWidth="110" />




                            </children>


                        </AnchorPane>









                        <!-- TABLE CARD -->


                        <AnchorPane layoutX="15" layoutY="165" prefHeight="350" prefWidth="680" style="-fx-background-color:#FFFFFF;                    -fx-background-radius:25;">


                            <children>


                                <Label layoutX="25" layoutY="25" text="Outstanding Invoice Records">


                                    <font>
                                        <Font size="20" />
                                    </font>


                                </Label>





                                <TableView fx:id="outstandingInvoiceTable" layoutX="20" layoutY="70" prefHeight="336.0" prefWidth="640">


                                    <columns>


                                        <TableColumn fx:id="invoiceIdColumn" prefWidth="100" text="Invoice ID" />


                                        <TableColumn fx:id="airlineColumn" prefWidth="120" text="Airline Name" />


                                        <TableColumn fx:id="amountColumn" prefWidth="110" text="Invoice Amount" />


                                        <TableColumn fx:id="dueDateColumn" prefWidth="100" text="Due Date" />


                                        <TableColumn fx:id="overdueColumn" prefWidth="100" text="Days Overdue" />


                                        <TableColumn fx:id="statusColumn" prefWidth="100" text="Status" />


                                    </columns>


                                </TableView>






                                <Button fx:id="generateReportButton" layoutX="320.0" layoutY="22.0" onAction="#GenerateReportOnAction" prefHeight="35" prefWidth="180" style="-fx-background-color:#F39C12;                -fx-background-radius:10;" text="Generate Report" textFill="WHITE" />



                            </children>


                        </AnchorPane>









                        <!-- SUMMARY CARD -->


                        <AnchorPane layoutX="500.0" layoutY="583.0" prefHeight="130" prefWidth="190" style="-fx-background-color:#FFF3CD;                    -fx-background-radius:25;">


                            <children>


                                <Label layoutX="20" layoutY="20" text="Summary">


                                    <font>
                                        <Font size="18" />
                                    </font>

                                </Label>




                                <Label layoutX="20" layoutY="60" text="Total Due:" />


                                <Label fx:id="totalDueLabel" layoutX="110" layoutY="60" text="0.00" />



                            </children>


                        </AnchorPane>





                    </children>


                </AnchorPane>


            </children>


        </VBox>


    </children>


</AnchorPane>
