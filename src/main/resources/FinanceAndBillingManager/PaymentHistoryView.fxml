<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="758.0" prefWidth="898.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.airport_catering_service.controller.finance_and_billing_manager.PaymentHistoryViewController">


    <children>
        <VBox layoutY="49.0" prefHeight="706.0" prefWidth="175.0" spacing="5">
            <children>
                <Button onAction="#sidebardashboardButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Dashboard">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sideBarCalculateCostButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Calculate Cost">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>

                <Button onAction="#sideBarGenerateInvoiceButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Generate Invoice">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>

                <Button onAction="#sideBarRecordPaymentButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Record Payment">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sideBarProcessRefundButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Process Refund">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sideBarOutstandingPaymentsButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Outstanding Payments">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sideBarFinancialReportsButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Financial Reports">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sideBarRevenueSummaryButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;" text="Revenue Summary">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
                <Button onAction="#sideBarPaymentHistoryButtonOnAction" prefHeight="46" prefWidth="174" style="-fx-background-radius:50px;         -fx-background-color:#8577F2;" text="Payment History" textFill="white">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
            </children>
        </VBox>
        <Button layoutY="3" onAction="#sidebarHomePageButtonOnAction" prefHeight="29" prefWidth="175" style="-fx-background-color:pink;         -fx-background-radius:5;" text="Airport Catering Service">
            <font>
                <Font name="Arial Bold" size="13" />
            </font>

            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <VBox layoutX="175" prefHeight="758" prefWidth="726" style="-fx-background-color:silver;">


            <children>
                <Label alignment="CENTER" prefWidth="609" text="welcome Username">
                    <font>
                        <Font name="Gabriola" size="18" />
                    </font>
                </Label>
                <AnchorPane prefHeight="734" prefWidth="726" style="-fx-background-color:white;">


                    <children>
                        <Label layoutX="56" layoutY="25" text="Payment History">
                            <font>
                                <Font size="24" />
                            </font>
                        </Label>
                        <Label layoutX="56" layoutY="65" text="View and manage all payment transactions" />

                        <AnchorPane layoutX="6" layoutY="105" prefHeight="200" prefWidth="712" style="-fx-background-color:white;             -fx-background-radius:25;">
                            <children>
                                <Label layoutX="25" layoutY="20" text="Payment Search Filter">
                                    <font>
                                        <Font size="20" />
                                    </font>
                                </Label>
                                <Label layoutX="25" layoutY="70" text="Invoice ID" />
                                <TextField fx:id="invoiceIdTextField" layoutX="120" layoutY="65" prefWidth="150" />
                                <Label layoutX="300" layoutY="70" text="Airline Name" />
                                <TextField fx:id="airlineTextField" layoutX="400" layoutY="65" prefWidth="160" />
                                <Label layoutX="25" layoutY="125" text="Payment Status" />
                                <ComboBox fx:id="paymentStatusComboBox" layoutX="120" layoutY="120" prefWidth="150" />
                                <Label layoutX="300" layoutY="125" text="Payment Method" />
                                <ComboBox fx:id="paymentMethodComboBox" layoutX="400" layoutY="120" prefWidth="160" />
                                <Button fx:id="searchPaymentBtn" layoutX="590" layoutY="120" onAction="#SearchOnAction" prefHeight="30" prefWidth="90" style="-fx-background-color:#0F6BFF;         -fx-text-fill:white;         -fx-background-radius:10;" text="Search" />
                            </children>
                        </AnchorPane>
                        <AnchorPane layoutX="6" layoutY="330" prefHeight="270" prefWidth="712" style="-fx-background-color:white;             -fx-background-radius:25;">
                            <children>
                                <Label layoutX="25" layoutY="20" text="Payment Transactions">
                                    <font>
                                        <Font size="20" />
                                    </font>
                                </Label>
                                <TableView fx:id="paymentTable" layoutX="20" layoutY="60" prefHeight="170" prefWidth="670">
                                    <columns>
                                        <TableColumn fx:id="paymentIdColumn" prefWidth="90" text="Payment ID" />
                                        <TableColumn fx:id="invoiceColumn" prefWidth="90" text="Invoice ID" />
                                        <TableColumn fx:id="airlineColumn" prefWidth="100" text="Airline" />
                                        <TableColumn fx:id="amountColumn" prefWidth="100" text="Amount Paid" />
                                        <TableColumn fx:id="methodColumn" prefWidth="90" text="Method" />
                                        <TableColumn fx:id="dateColumn" prefWidth="90" text="Date" />
                                        <TableColumn fx:id="statusColumn" prefWidth="100" text="Status" />
                                    </columns>
                                </TableView>
                            </children>
                        </AnchorPane>
                        <AnchorPane layoutX="6" layoutY="625" prefHeight="80" prefWidth="712" style="-fx-background-color:#EAF2FF;             -fx-background-radius:20;">


                            <children>
                                <Button fx:id="receiptBtn" layoutX="32.0" layoutY="22.0" onAction="#viewpaymentButtonOnAction" prefHeight="35" prefWidth="150" style="-fx-background-color:green;         -fx-text-fill:white;         -fx-background-radius:10;" text="View Payement" />
                            </children>
                        </AnchorPane>
                    </children>
                </AnchorPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
