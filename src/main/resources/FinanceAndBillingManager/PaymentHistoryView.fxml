<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="758.0"
            prefWidth="898.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="CONTROLLER_NAME">


    <children>


        <!-- ================= SIDEBAR ================= -->


        <VBox layoutY="49.0"
              prefHeight="706.0"
              prefWidth="175.0"
              spacing="5">


            <children>


                <Button text="Dashboard"
                        prefHeight="46"
                        prefWidth="174"
                        style="-fx-background-radius:50px;">
                    <font>
                        <Font size="15"/>
                    </font>
                </Button>


                <Button text="Calculate Cost"
                        prefHeight="46"
                        prefWidth="174"
                        style="-fx-background-radius:50px;">
                    <font>
                        <Font size="15"/>
                    </font>
                </Button>



                <Button text="Generate Invoice"
                        prefHeight="46"
                        prefWidth="174"
                        style="-fx-background-radius:50px;">
                    <font>
                        <Font size="15"/>
                    </font>
                </Button>




                <Button text="Record Payment"
                        prefHeight="46"
                        prefWidth="174"
                        style="-fx-background-radius:50px;">
                    <font>
                        <Font size="15"/>
                    </font>
                </Button>





                <Button text="Process Refund"
                        prefHeight="46"
                        prefWidth="174"
                        style="-fx-background-radius:50px;">
                    <font>
                        <Font size="15"/>
                    </font>
                </Button>






                <Button text="Outstanding Payments"
                        prefHeight="46"
                        prefWidth="174"
                        style="-fx-background-radius:50px;">
                    <font>
                        <Font size="15"/>
                    </font>
                </Button>






                <Button text="Financial Reports"
                        prefHeight="46"
                        prefWidth="174"
                        style="-fx-background-radius:50px;">
                    <font>
                        <Font size="15"/>
                    </font>
                </Button>





                <Button text="Revenue Summary"
                        prefHeight="46"
                        prefWidth="174"
                        style="-fx-background-radius:50px;">
                    <font>
                        <Font size="15"/>
                    </font>
                </Button>






                <Button text="Payment History"
                        prefHeight="46"
                        prefWidth="174"
                        style="-fx-background-radius:50px;
        -fx-background-color:#8577F2;"
                        textFill="white">


                    <font>
                        <Font size="15"/>
                    </font>


                </Button>


            </children>

        </VBox>







        <!-- TOP HEADER -->


        <Button layoutY="3"
                prefHeight="29"
                prefWidth="175"
                text="Airport Catering Service"
                style="-fx-background-color:pink;
        -fx-background-radius:5;">


            <font>
                <Font name="Arial Bold" size="13"/>
            </font>


            <cursor>
                <Cursor fx:constant="HAND"/>
            </cursor>


        </Button>







        <!-- MAIN CONTENT -->


        <VBox layoutX="175"
              prefHeight="758"
              prefWidth="726"
              style="-fx-background-color:silver;">


            <children>



                <Label text="welcome Username"
                       alignment="CENTER"
                       prefWidth="609">


                    <font>
                        <Font name="Gabriola" size="18"/>
                    </font>


                </Label>






                <AnchorPane prefHeight="734"
                            prefWidth="726"
                            style="-fx-background-color:white;">


                    <children>





                        <!-- PAGE TITLE -->


                        <Label layoutX="56"
                               layoutY="25"
                               text="Payment History">


                            <font>
                                <Font size="24"/>
                            </font>


                        </Label>



                        <Label layoutX="56"
                               layoutY="65"
                               text="View and manage all payment transactions"/>








                        <!-- FILTER SECTION -->


                        <AnchorPane layoutX="6"
                                    layoutY="105"
                                    prefHeight="200"
                                    prefWidth="712"
                                    style="-fx-background-color:white;
            -fx-background-radius:25;">


                            <children>



                                <Label layoutX="25"
                                       layoutY="20"
                                       text="Payment Search Filter">


                                    <font>
                                        <Font size="20"/>
                                    </font>


                                </Label>






                                <Label layoutX="25"
                                       layoutY="70"
                                       text="Invoice ID"/>



                                <TextField fx:id="invoiceIdField"
                                           layoutX="120"
                                           layoutY="65"
                                           prefWidth="150"/>





                                <Label layoutX="300"
                                       layoutY="70"
                                       text="Airline Name"/>



                                <TextField fx:id="airlineField"
                                           layoutX="400"
                                           layoutY="65"
                                           prefWidth="160"/>







                                <Label layoutX="25"
                                       layoutY="125"
                                       text="Payment Status"/>



                                <ComboBox fx:id="paymentStatusCombo"
                                          layoutX="120"
                                          layoutY="120"
                                          prefWidth="150"/>







                                <Label layoutX="300"
                                       layoutY="125"
                                       text="Payment Method"/>



                                <ComboBox fx:id="paymentMethodCombo"
                                          layoutX="400"
                                          layoutY="120"
                                          prefWidth="160"/>





                                <Button fx:id="searchPaymentBtn"
                                        layoutX="590"
                                        layoutY="120"
                                        prefWidth="90"
                                        prefHeight="30"
                                        text="Search"
                                        style="-fx-background-color:#0F6BFF;
        -fx-text-fill:white;
        -fx-background-radius:10;"/>



                            </children>


                        </AnchorPane>









                        <!-- PAYMENT TABLE -->


                        <AnchorPane layoutX="6"
                                    layoutY="330"
                                    prefHeight="270"
                                    prefWidth="712"
                                    style="-fx-background-color:white;
            -fx-background-radius:25;">


                            <children>



                                <Label layoutX="25"
                                       layoutY="20"
                                       text="Payment Transactions">


                                    <font>
                                        <Font size="20"/>
                                    </font>


                                </Label>





                                <TableView fx:id="paymentTable"
                                           layoutX="20"
                                           layoutY="60"
                                           prefWidth="670"
                                           prefHeight="170">


                                    <columns>


                                        <TableColumn fx:id="paymentIdColumn"
                                                     text="Payment ID"
                                                     prefWidth="90"/>


                                        <TableColumn fx:id="invoiceColumn"
                                                     text="Invoice ID"
                                                     prefWidth="90"/>


                                        <TableColumn fx:id="airlineColumn"
                                                     text="Airline"
                                                     prefWidth="100"/>


                                        <TableColumn fx:id="amountColumn"
                                                     text="Amount Paid"
                                                     prefWidth="100"/>


                                        <TableColumn fx:id="methodColumn"
                                                     text="Method"
                                                     prefWidth="90"/>


                                        <TableColumn fx:id="dateColumn"
                                                     text="Date"
                                                     prefWidth="90"/>


                                        <TableColumn fx:id="statusColumn"
                                                     text="Status"
                                                     prefWidth="100"/>


                                    </columns>


                                </TableView>




                            </children>


                        </AnchorPane>









                        <!-- ACTION PANEL -->


                        <AnchorPane layoutX="6"
                                    layoutY="625"
                                    prefHeight="80"
                                    prefWidth="712"
                                    style="-fx-background-color:#EAF2FF;
            -fx-background-radius:20;">


                            <children>




                                <Button fx:id="viewPaymentBtn"
                                        layoutX="30"
                                        layoutY="22"
                                        prefWidth="140"
                                        prefHeight="35"
                                        text="View Payment"
                                        style="-fx-background-radius:10;"/>





                                <Button fx:id="receiptBtn"
                                        layoutX="200"
                                        layoutY="22"
                                        prefWidth="150"
                                        prefHeight="35"
                                        text="Download Receipt"
                                        style="-fx-background-color:green;
        -fx-text-fill:white;
        -fx-background-radius:10;"/>






                                <Button fx:id="exportBtn"
                                        layoutX="390"
                                        layoutY="22"
                                        prefWidth="120"
                                        prefHeight="35"
                                        text="Export PDF"
                                        style="-fx-background-radius:10;"/>




                                <Button fx:id="resetBtn"
                                        layoutX="540"
                                        layoutY="22"
                                        prefWidth="100"
                                        prefHeight="35"
                                        text="Reset"
                                        style="-fx-background-radius:10;"/>




                            </children>


                        </AnchorPane>






                    </children>


                </AnchorPane>


            </children>


        </VBox>


    </children>


</AnchorPane>