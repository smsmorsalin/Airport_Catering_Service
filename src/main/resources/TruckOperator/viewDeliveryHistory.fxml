<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1300"
            prefHeight="850"
            fx:controller="main.airport_catering_service.controller.truck_operator.DeliveryPerformanceReportController">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to right,#1F618D,#3498DB);">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="📊 Delivery Performance Report">

                <font>
                    <Font size="30"/>
                </font>

                <style>
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                </style>

            </Label>

            <Label text="View delivery performance and transportation statistics">

                <style>
                    -fx-text-fill:white;
                    -fx-font-size:15;
                </style>

            </Label>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="18">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Filter -->

            <TitledPane text="Report Filters"
                        expanded="true"
                        collapsible="false">

                <content>

                    <GridPane hgap="20" vgap="15">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="From Date"/>

                        <DatePicker fx:id="fromDatePicker"
                                    GridPane.columnIndex="1"/>

                        <Label text="To Date"
                               GridPane.columnIndex="2"/>

                        <DatePicker fx:id="toDatePicker"
                                    GridPane.columnIndex="3"/>

                        <Button text="Generate Report"
                                fx:id="generateReportButton"
                                prefWidth="160"
                                onAction="#generateReport"
                                style="-fx-background-color:#27AE60;-fx-text-fill:white;-fx-font-weight:bold;"
                                GridPane.columnIndex="4"/>

                        <Button text="Reset"
                                fx:id="resetButton"
                                prefWidth="120"
                                onAction="#resetFilter"
                                style="-fx-background-color:#F39C12;-fx-text-fill:white;"
                                GridPane.columnIndex="5"/>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- Summary -->

            <TitledPane text="Delivery Summary"
                        expanded="true"
                        collapsible="false">

                <content>

                    <GridPane hgap="30" vgap="18">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="Total Deliveries"/>
                        <Label fx:id="totalDeliveriesLabel"
                               text="0"
                               GridPane.columnIndex="1"/>

                        <Label text="Successful Deliveries"
                               GridPane.columnIndex="2"/>
                        <Label fx:id="successfulDeliveriesLabel"
                               text="0"
                               GridPane.columnIndex="3"/>

                        <Label text="Delayed Deliveries"
                               GridPane.rowIndex="1"/>
                        <Label fx:id="delayedDeliveriesLabel"
                               text="0"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                        <Label text="Reported Issues"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="2"/>
                        <Label fx:id="reportedIssuesLabel"
                               text="0"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="3"/>

                        <Label text="On-Time Delivery Rate"
                               GridPane.rowIndex="2"/>
                        <ProgressBar fx:id="onTimeProgressBar"
                                     progress="0.0"
                                     prefWidth="250"
                                     GridPane.rowIndex="2"
                                     GridPane.columnIndex="1"/>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- Report Table -->

            <TitledPane text="Delivery Report"
                        expanded="true"
                        collapsible="false"
                        VBox.vgrow="ALWAYS">

                <content>

                    <TableView fx:id="reportTable">

                        <columns>

                            <TableColumn fx:id="assignmentIdColumn"
                                         text="Assignment ID"
                                         prefWidth="130"/>

                            <TableColumn fx:id="orderIdColumn"
                                         text="Order ID"
                                         prefWidth="120"/>

                            <TableColumn fx:id="flightNumberColumn"
                                         text="Flight"
                                         prefWidth="130"/>

                            <TableColumn fx:id="airlineColumn"
                                         text="Airline"
                                         prefWidth="170"/>

                            <TableColumn fx:id="destinationColumn"
                                         text="Destination"
                                         prefWidth="180"/>

                            <TableColumn fx:id="deliveryTimeColumn"
                                         text="Delivery Time"
                                         prefWidth="180"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Status"
                                         prefWidth="150"/>

                            <TableColumn fx:id="remarksColumn"
                                         text="Remarks"
                                         prefWidth="220"/>

                        </columns>

                    </TableView>

                </content>

            </TitledPane>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-background-color:#ECF0F1;">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Button text="Export PDF"
                    fx:id="exportPdfButton"
                    prefWidth="140"
                    onAction="#exportPDF"
                    style="-fx-background-color:#8E44AD;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Print Report"
                    fx:id="printButton"
                    prefWidth="140"
                    onAction="#printReport"
                    style="-fx-background-color:#2980B9;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Refresh"
                    fx:id="refreshButton"
                    prefWidth="120"
                    onAction="#refreshReport"
                    style="-fx-background-color:#16A085;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="120"
                    onAction="#goBack"
                    style="-fx-background-color:#E74C3C;-fx-text-fill:white;-fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>