<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1280"
            prefHeight="820"
            fx:controller="main.airport_catering_service.controller.truck_operator.ConfirmDeliveryController">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to right,#117A65,#1ABC9C);">

            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="✅ Confirm Delivery">

                <font>
                    <Font size="30"/>
                </font>

                <style>
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                </style>

            </Label>

            <Label text="Confirm successful meal delivery to the aircraft.">

                <style>
                    -fx-text-fill:white;
                    -fx-font-size:15;
                </style>

            </Label>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Delivery Details -->

            <TitledPane text="Delivery Information"
                        collapsible="false"
                        expanded="true">

                <content>

                    <GridPane hgap="20" vgap="18">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Assignment ID"/>

                        <TextField fx:id="assignmentIdField"
                                   promptText="Enter Assignment ID"
                                   prefWidth="220"
                                   GridPane.columnIndex="1"/>

                        <Button text="Load Assignment"
                                fx:id="loadButton"
                                prefWidth="150"
                                onAction="#loadAssignment"
                                style="-fx-background-color:#3498DB;-fx-text-fill:white;-fx-font-weight:bold;"
                                GridPane.columnIndex="2"/>

                        <Label text="Order ID"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="orderIdField"
                                   editable="false"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <Label text="Flight Number"
                               GridPane.rowIndex="2"/>

                        <TextField fx:id="flightNumberField"
                                   editable="false"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="1"/>

                        <Label text="Airline"
                               GridPane.rowIndex="3"/>

                        <TextField fx:id="airlineField"
                                   editable="false"
                                   GridPane.rowIndex="3"
                                   GridPane.columnIndex="1"/>

                        <Label text="Delivery Location"
                               GridPane.rowIndex="4"/>

                        <TextField fx:id="locationField"
                                   editable="false"
                                   GridPane.rowIndex="4"
                                   GridPane.columnIndex="1"/>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- Delivery Confirmation -->

            <TitledPane text="Delivery Confirmation"
                        collapsible="false"
                        expanded="true">

                <content>

                    <GridPane hgap="20" vgap="18">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Receiver Name"/>

                        <TextField fx:id="receiverNameField"
                                   promptText="Enter Receiver Name"
                                   GridPane.columnIndex="1"/>

                        <Label text="Receiver ID"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="receiverIdField"
                                   promptText="Employee ID"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <Label text="Delivery Date"
                               GridPane.rowIndex="2"/>

                        <DatePicker fx:id="deliveryDatePicker"
                                    GridPane.rowIndex="2"
                                    GridPane.columnIndex="1"/>

                        <Label text="Remarks"
                               GridPane.rowIndex="3"/>

                        <TextArea fx:id="remarksTextArea"
                                  prefHeight="100"
                                  wrapText="true"
                                  promptText="Optional remarks..."
                                  GridPane.rowIndex="3"
                                  GridPane.columnIndex="1"
                                  GridPane.columnSpan="2"/>

                        <HBox spacing="15"
                              GridPane.rowIndex="4"
                              GridPane.columnIndex="1">

                            <Button text="Confirm Delivery"
                                    fx:id="confirmButton"
                                    prefWidth="180"
                                    prefHeight="40"
                                    onAction="#confirmDelivery"
                                    style="-fx-background-color:#27AE60;-fx-text-fill:white;-fx-font-weight:bold;"/>

                            <Button text="Reset"
                                    fx:id="resetButton"
                                    prefWidth="120"
                                    prefHeight="40"
                                    onAction="#resetForm"
                                    style="-fx-background-color:#F39C12;-fx-text-fill:white;-fx-font-weight:bold;"/>

                        </HBox>

                    </GridPane>

                </content>

            </TitledPane>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox alignment="CENTER_RIGHT"
              spacing="15"
              style="-fx-background-color:#ECF0F1;">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="120"
                    onAction="#goBack"
                    style="-fx-background-color:#566573;-fx-text-fill:white;-fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>