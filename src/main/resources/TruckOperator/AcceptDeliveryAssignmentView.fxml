<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1280"
            prefHeight="820"
            fx:controller="main.airport_catering_service.controller.truck_operator.AcceptAssignmentController">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to right,#1E3A5F,#2E86C1);">

            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="✅ Accept Delivery Assignment">

                <font>
                    <Font size="30"/>
                </font>

                <style>
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                </style>

            </Label>

            <Label text="Review delivery details before accepting the assignment.">

                <style>
                    -fx-text-fill:white;
                    -fx-font-size:15;
                </style>

            </Label>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <!-- Assignment Search -->

            <TitledPane text="Assignment Information"
                        collapsible="false"
                        expanded="true">

                <content>

                    <GridPane hgap="20"
                              vgap="18">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="Assignment ID"/>

                        <TextField fx:id="assignmentIdField"
                                   promptText="Enter Assignment ID"
                                   prefWidth="220"
                                   GridPane.columnIndex="1"/>

                        <Button text="Load Assignment"
                                fx:id="loadButton"
                                prefWidth="150"
                                onAction="#loadAssignment"
                                style="-fx-background-color:#3498DB;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;"
                                GridPane.columnIndex="2"/>

                        <Label text="Order ID"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="orderIdField"
                                   editable="false"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <Label text="Flight Number"
                               GridPane.rowIndex="2"/>

                        <TextField fx:id="flightNumberField"
                                   editable="false"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="1"/>

                        <Label text="Airline"
                               GridPane.rowIndex="3"/>

                        <TextField fx:id="airlineField"
                                   editable="false"
                                   GridPane.rowIndex="3"
                                   GridPane.columnIndex="1"/>

                        <Label text="Delivery Location"
                               GridPane.rowIndex="4"/>

                        <TextField fx:id="locationField"
                                   editable="false"
                                   GridPane.rowIndex="4"
                                   GridPane.columnIndex="1"/>

                        <Label text="Delivery Time"
                               GridPane.rowIndex="5"/>

                        <TextField fx:id="deliveryTimeField"
                                   editable="false"
                                   GridPane.rowIndex="5"
                                   GridPane.columnIndex="1"/>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- Assignment Confirmation -->

            <TitledPane text="Assignment Decision"
                        collapsible="false"
                        expanded="true">

                <content>

                    <VBox spacing="18">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="Do you want to accept this delivery assignment?"
                               style="-fx-font-size:16; -fx-font-weight:bold;"/>

                        <HBox spacing="20"
                              alignment="CENTER_LEFT">

                            <Button text="Accept Assignment"
                                    fx:id="acceptButton"
                                    prefWidth="180"
                                    prefHeight="40"
                                    onAction="#acceptAssignment"
                                    style="-fx-background-color:#27AE60;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;"/>

                            <Button text="Reject Assignment"
                                    fx:id="rejectButton"
                                    prefWidth="180"
                                    prefHeight="40"
                                    onAction="#rejectAssignment"
                                    style="-fx-background-color:#E74C3C;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;"/>

                            <Button text="Clear"
                                    fx:id="clearButton"
                                    prefWidth="120"
                                    prefHeight="40"
                                    onAction="#clearForm"
                                    style="-fx-background-color:#F39C12;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;"/>

                        </HBox>

                    </VBox>

                </content>

            </TitledPane>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox alignment="CENTER_RIGHT"
              spacing="15"
              style="-fx-background-color:#ECF0F1;">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="120"
                    onAction="#goBack"
                    style="-fx-background-color:#566573;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>