<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1280"
            prefHeight="820"
            fx:controller="main.airport_catering_service.controller.truck_operator.ViewAssignedDeliveriesController">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to right,#154360,#2471A3);">

            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="🚚 View Assigned Deliveries">

                <font>
                    <Font size="30"/>
                </font>

                <style>
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                </style>

            </Label>

            <Label text="View and monitor all assigned delivery schedules">

                <style>
                    -fx-text-fill:white;
                    -fx-font-size:15;
                </style>

            </Label>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="18">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Search Panel -->

            <TitledPane text="Search Assigned Deliveries"
                        collapsible="false"
                        expanded="true">

                <content>

                    <GridPane hgap="20"
                              vgap="18">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="Delivery Date"/>

                        <DatePicker fx:id="deliveryDatePicker"
                                    GridPane.columnIndex="1"/>

                        <Label text="Assignment ID"
                               GridPane.columnIndex="2"/>

                        <TextField fx:id="assignmentIdField"
                                   promptText="Optional"
                                   prefWidth="220"
                                   GridPane.columnIndex="3"/>

                        <Button text="Search"
                                fx:id="searchButton"
                                prefWidth="120"
                                onAction="#searchDeliveries"
                                style="-fx-background-color:#27AE60;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;"
                                GridPane.columnIndex="4"/>

                        <Button text="Clear"
                                fx:id="clearButton"
                                prefWidth="120"
                                onAction="#clearSearch"
                                style="-fx-background-color:#F39C12;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;"
                                GridPane.columnIndex="5"/>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- Assigned Delivery Table -->

            <TitledPane text="Assigned Deliveries"
                        collapsible="false"
                        expanded="true"
                        VBox.vgrow="ALWAYS">

                <content>

                    <TableView fx:id="deliveryTable">

                        <columns>

                            <TableColumn fx:id="assignmentIdColumn"
                                         text="Assignment ID"
                                         prefWidth="130"/>

                            <TableColumn fx:id="orderIdColumn"
                                         text="Order ID"
                                         prefWidth="120"/>

                            <TableColumn fx:id="flightNumberColumn"
                                         text="Flight Number"
                                         prefWidth="140"/>

                            <TableColumn fx:id="airlineColumn"
                                         text="Airline"
                                         prefWidth="180"/>

                            <TableColumn fx:id="locationColumn"
                                         text="Delivery Location"
                                         prefWidth="220"/>

                            <TableColumn fx:id="deliveryTimeColumn"
                                         text="Delivery Time"
                                         prefWidth="170"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Dispatch Status"
                                         prefWidth="170"/>

                        </columns>

                    </TableView>

                </content>

            </TitledPane>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-background-color:#ECF0F1;">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Button text="Refresh"
                    fx:id="refreshButton"
                    prefWidth="120"
                    onAction="#refreshTable"
                    style="-fx-background-color:#3498DB;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;"/>

            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="120"
                    onAction="#goBack"
                    style="-fx-background-color:#E74C3C;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>