<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1280"
            prefHeight="820"
            fx:controller="main.airport_catering_service.controller.headchef.HandleRejectedBatchController">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to right,#922B21,#C0392B);">

            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="❌ Handle Rejected Meal Batch">
                <font>
                    <Font size="30"/>
                </font>
                <style>
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                </style>
            </Label>

            <Label text="Review rejected batches and assign corrective actions.">
                <style>
                    -fx-text-fill:white;
                    -fx-font-size:15;
                </style>
            </Label>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="18">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Batch Information -->

            <TitledPane text="Rejected Batch Information"
                        expanded="true"
                        collapsible="false">

                <content>

                    <GridPane hgap="20" vgap="18">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Production Task ID"/>
                        <TextField fx:id="taskIdField"
                                   promptText="Enter Production Task ID"
                                   prefWidth="220"
                                   GridPane.columnIndex="1"/>

                        <Button text="Load Batch"
                                fx:id="loadBatchButton"
                                onAction="#loadRejectedBatch"
                                prefWidth="130"
                                style="-fx-background-color:#3498DB;-fx-text-fill:white;-fx-font-weight:bold;"
                                GridPane.columnIndex="2"/>

                        <Label text="Batch ID"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="batchIdField"
                                   editable="false"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <Label text="Rejected By"
                               GridPane.rowIndex="2"/>

                        <TextField fx:id="rejectedByField"
                                   editable="false"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="1"/>

                        <Label text="Rejection Reason"
                               GridPane.rowIndex="3"/>

                        <TextArea fx:id="rejectionReasonTextArea"
                                  editable="false"
                                  wrapText="true"
                                  prefHeight="90"
                                  GridPane.rowIndex="3"
                                  GridPane.columnIndex="1"
                                  GridPane.columnSpan="2"/>

                        <Label text="Corrective Action"
                               GridPane.rowIndex="4"/>

                        <ComboBox fx:id="actionComboBox"
                                  promptText="Select Action"
                                  prefWidth="220"
                                  GridPane.rowIndex="4"
                                  GridPane.columnIndex="1"/>

                        <Label text="Assign Kitchen Team"
                               GridPane.rowIndex="5"/>

                        <ComboBox fx:id="teamComboBox"
                                  promptText="Select Team"
                                  prefWidth="220"
                                  GridPane.rowIndex="5"
                                  GridPane.columnIndex="1"/>

                        <Label text="Head Chef Notes"
                               GridPane.rowIndex="6"/>

                        <TextArea fx:id="chefRemarksTextArea"
                                  promptText="Additional remarks..."
                                  wrapText="true"
                                  prefHeight="90"
                                  GridPane.rowIndex="6"
                                  GridPane.columnIndex="1"
                                  GridPane.columnSpan="2"/>

                        <HBox spacing="15"
                              GridPane.rowIndex="7"
                              GridPane.columnIndex="1">

                            <Button text="Submit Action"
                                    fx:id="submitButton"
                                    onAction="#submitCorrectiveAction"
                                    prefWidth="160"
                                    style="-fx-background-color:#27AE60;-fx-text-fill:white;-fx-font-weight:bold;"/>

                            <Button text="Clear"
                                    fx:id="clearButton"
                                    onAction="#clearForm"
                                    prefWidth="120"
                                    style="-fx-background-color:#F39C12;-fx-text-fill:white;-fx-font-weight:bold;"/>

                        </HBox>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- Rejected Batch History -->

            <TitledPane text="Rejected Batch History"
                        expanded="true"
                        collapsible="false"
                        VBox.vgrow="ALWAYS">

                <content>

                    <TableView fx:id="rejectedBatchTable">

                        <columns>

                            <TableColumn fx:id="batchIdColumn"
                                         text="Batch ID"
                                         prefWidth="120"/>

                            <TableColumn fx:id="taskIdColumn"
                                         text="Task ID"
                                         prefWidth="120"/>

                            <TableColumn fx:id="mealTypeColumn"
                                         text="Meal Type"
                                         prefWidth="180"/>

                            <TableColumn fx:id="reasonColumn"
                                         text="Rejection Reason"
                                         prefWidth="250"/>

                            <TableColumn fx:id="actionColumn"
                                         text="Corrective Action"
                                         prefWidth="180"/>

                            <TableColumn fx:id="assignedTeamColumn"
                                         text="Assigned Team"
                                         prefWidth="170"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Current Status"
                                         prefWidth="170"/>

                        </columns>

                    </TableView>

                </content>

            </TitledPane>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox alignment="CENTER_RIGHT"
              spacing="15"
              style="-fx-background-color:#ECF0F1;">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button text="Refresh"
                    fx:id="refreshButton"
                    onAction="#refreshTable"
                    prefWidth="120"
                    style="-fx-background-color:#16A085;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Back"
                    fx:id="backButton"
                    onAction="#goBack"
                    prefWidth="120"
                    style="-fx-background-color:#E74C3C;-fx-text-fill:white;-fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>