<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1280"
            prefHeight="820"
            fx:controller="main.airport_catering_service.controller.headchef.UpdateProductionStatusController">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to right,#1F618D,#3498DB);">

            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="📋 Update Production Status">
                <font>
                    <Font size="30"/>
                </font>
                <style>
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                </style>
            </Label>

            <Label text="Update the current production progress for kitchen operations.">
                <style>
                    -fx-text-fill:white;
                    -fx-font-size:15;
                </style>
            </Label>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Update Form -->

            <TitledPane text="Production Status Update"
                        collapsible="false"
                        expanded="true">

                <content>

                    <GridPane hgap="20" vgap="18">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Production Task ID"/>

                        <TextField fx:id="taskIdField"
                                   promptText="Enter Production Task ID"
                                   prefWidth="220"
                                   GridPane.columnIndex="1"/>

                        <Button text="Load Task"
                                fx:id="loadButton"
                                prefWidth="120"
                                onAction="#loadTask"
                                style="-fx-background-color:#3498DB;-fx-text-fill:white;-fx-font-weight:bold;"
                                GridPane.columnIndex="2"/>

                        <Label text="Current Status"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="currentStatusField"
                                   editable="false"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <Label text="New Status"
                               GridPane.rowIndex="2"/>

                        <ComboBox fx:id="statusComboBox"
                                  promptText="Select Status"
                                  prefWidth="220"
                                  GridPane.rowIndex="2"
                                  GridPane.columnIndex="1"/>

                        <Label text="Completion (%)"
                               GridPane.rowIndex="3"/>

                        <Slider fx:id="completionSlider"
                                min="0"
                                max="100"
                                showTickLabels="true"
                                showTickMarks="true"
                                majorTickUnit="25"
                                minorTickCount="4"
                                blockIncrement="5"
                                prefWidth="350"
                                GridPane.rowIndex="3"
                                GridPane.columnIndex="1"/>

                        <Label fx:id="completionLabel"
                               text="0%"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="2"/>

                        <Label text="Remarks"
                               GridPane.rowIndex="4"/>

                        <TextArea fx:id="remarksTextArea"
                                  promptText="Enter production remarks..."
                                  wrapText="true"
                                  prefHeight="120"
                                  GridPane.rowIndex="4"
                                  GridPane.columnIndex="1"
                                  GridPane.columnSpan="2"/>

                        <HBox spacing="15"
                              GridPane.rowIndex="5"
                              GridPane.columnIndex="1">

                            <Button text="Update Status"
                                    fx:id="updateButton"
                                    prefWidth="150"
                                    onAction="#updateStatus"
                                    style="-fx-background-color:#27AE60;-fx-text-fill:white;-fx-font-weight:bold;"/>

                            <Button text="Reset"
                                    fx:id="resetButton"
                                    prefWidth="120"
                                    onAction="#resetForm"
                                    style="-fx-background-color:#F39C12;-fx-text-fill:white;-fx-font-weight:bold;"/>

                        </HBox>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- Status Table -->

            <TitledPane text="Updated Production Records"
                        collapsible="false"
                        expanded="true"
                        VBox.vgrow="ALWAYS">

                <content>

                    <TableView fx:id="productionTable">

                        <columns>

                            <TableColumn fx:id="taskIdColumn"
                                         text="Task ID"
                                         prefWidth="120"/>

                            <TableColumn fx:id="mealCategoryColumn"
                                         text="Meal Category"
                                         prefWidth="170"/>

                            <TableColumn fx:id="teamColumn"
                                         text="Assigned Team"
                                         prefWidth="180"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Production Status"
                                         prefWidth="170"/>

                            <TableColumn fx:id="completionColumn"
                                         text="Completion %"
                                         prefWidth="140"/>

                            <TableColumn fx:id="lastUpdatedColumn"
                                         text="Last Updated"
                                         prefWidth="180"/>

                            <TableColumn fx:id="remarksColumn"
                                         text="Remarks"
                                         prefWidth="260"/>

                        </columns>

                    </TableView>

                </content>

            </TitledPane>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-background-color:#ECF0F1;">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button text="Refresh"
                    fx:id="refreshButton"
                    prefWidth="120"
                    onAction="#refreshTable"
                    style="-fx-background-color:#16A085;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="120"
                    onAction="#goBack"
                    style="-fx-background-color:#E74C3C;-fx-text-fill:white;-fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>