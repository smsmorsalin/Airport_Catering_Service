<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.airport_catering_service.controller.headchef.ViewProductionTasksController"
            prefHeight="800.0"
            prefWidth="1200.0">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox spacing="12" style="-fx-background-color:#34495E;">

            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <Label text="🍽 Head Chef Dashboard">
                <font>
                    <Font size="30"/>
                </font>
                <style>
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                </style>
            </Label>

            <Label text="View and manage assigned production tasks">
                <style>
                    -fx-text-fill:#ECF0F1;
                    -fx-font-size:15;
                </style>
            </Label>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <!-- SEARCH CARD -->

            <TitledPane text="Search Production Task"
                        expanded="true"
                        collapsible="false">

                <content>

                    <GridPane hgap="18" vgap="18">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Production Task ID:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="productionTaskIdField"
                                   promptText="Enter Task ID"
                                   prefWidth="220"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                        <Label text="Order ID (Optional):"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="orderIdField"
                                   promptText="Enter Order ID"
                                   prefWidth="220"
                                   GridPane.columnIndex="3"
                                   GridPane.rowIndex="0"/>

                        <Button text="🔍 Search"
                                fx:id="searchButton"
                                onAction="#searchTask"
                                prefWidth="120"
                                prefHeight="35"
                                style="-fx-background-color:#2E86DE;-fx-text-fill:white;-fx-font-weight:bold;"
                                GridPane.columnIndex="4"
                                GridPane.rowIndex="0"/>

                        <Button text="Clear"
                                fx:id="clearButton"
                                onAction="#clearFields"
                                prefWidth="100"
                                prefHeight="35"
                                style="-fx-background-color:#95A5A6;-fx-text-fill:white;"
                                GridPane.columnIndex="5"
                                GridPane.rowIndex="0"/>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- TABLE -->

            <TitledPane text="Production Task Details"
                        expanded="true"
                        collapsible="false"
                        VBox.vgrow="ALWAYS">

                <content>

                    <TableView fx:id="productionTaskTable"
                               prefHeight="500">

                        <columns>

                            <TableColumn fx:id="taskIdColumn"
                                         text="Task ID"
                                         prefWidth="120"/>

                            <TableColumn fx:id="orderIdColumn"
                                         text="Order ID"
                                         prefWidth="110"/>

                            <TableColumn fx:id="airlineColumn"
                                         text="Airline Name"
                                         prefWidth="170"/>

                            <TableColumn fx:id="flightColumn"
                                         text="Flight Number"
                                         prefWidth="150"/>

                            <TableColumn fx:id="mealTypeColumn"
                                         text="Meal Types"
                                         prefWidth="220"/>

                            <TableColumn fx:id="mealQuantityColumn"
                                         text="Meal Quantity"
                                         prefWidth="120"/>

                            <TableColumn fx:id="completionTimeColumn"
                                         text="Completion Time"
                                         prefWidth="180"/>

                            <TableColumn fx:id="priorityColumn"
                                         text="Priority"
                                         prefWidth="120"/>

                        </columns>

                    </TableView>

                </content>

            </TitledPane>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-background-color:#ECF0F1;">

            <padding>
                <Insets top="15" right="25" bottom="15" left="25"/>
            </padding>

            <Button text="Refresh"
                    fx:id="refreshButton"
                    onAction="#refreshTable"
                    prefWidth="120"
                    prefHeight="35"
                    style="-fx-background-color:#27AE60;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Back"
                    fx:id="backButton"
                    onAction="#goBack"
                    prefWidth="120"
                    prefHeight="35"
                    style="-fx-background-color:#E74C3C;-fx-text-fill:white;-fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>