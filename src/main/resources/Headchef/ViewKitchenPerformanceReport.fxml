<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1300"
            prefHeight="850"
            fx:controller="main.airport_catering_service.controller.headchef.KitchenPerformanceReportController">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to right,#1B4F72,#21618C);">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="📊 Kitchen Performance Report">

                <font>
                    <Font size="30"/>
                </font>

                <style>
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                </style>

            </Label>

            <Label text="Monitor kitchen productivity and production performance">

                <style>
                    -fx-text-fill:white;
                    -fx-font-size:15;
                </style>

            </Label>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="18">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- FILTER -->

            <TitledPane text="Report Filters"
                        expanded="true"
                        collapsible="false">

                <content>

                    <GridPane hgap="20"
                              vgap="15">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="From Date"/>

                        <DatePicker fx:id="fromDatePicker"
                                    GridPane.columnIndex="1"/>

                        <Label text="To Date"
                               GridPane.columnIndex="2"/>

                        <DatePicker fx:id="toDatePicker"
                                    GridPane.columnIndex="3"/>

                        <Button text="Generate Report"
                                fx:id="generateReportButton"
                                prefWidth="160"
                                onAction="#generateReport"
                                style="-fx-background-color:#27AE60;-fx-text-fill:white;-fx-font-weight:bold;"
                                GridPane.columnIndex="4"/>

                        <Button text="Reset"
                                fx:id="resetButton"
                                prefWidth="120"
                                onAction="#resetFilter"
                                style="-fx-background-color:#F39C12;-fx-text-fill:white;"
                                GridPane.columnIndex="5"/>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- SUMMARY -->

            <TitledPane text="Kitchen Summary"
                        expanded="true"
                        collapsible="false">

                <content>

                    <GridPane hgap="30"
                              vgap="18">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="Total Production Tasks"/>
                        <Label fx:id="totalTasksLabel"
                               text="0"
                               GridPane.columnIndex="1"/>

                        <Label text="Meals Prepared"
                               GridPane.columnIndex="2"/>
                        <Label fx:id="mealsPreparedLabel"
                               text="0"
                               GridPane.columnIndex="3"/>

                        <Label text="Completed Tasks"
                               GridPane.rowIndex="1"/>
                        <Label fx:id="completedTasksLabel"
                               text="0"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                        <Label text="Pending Tasks"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="2"/>
                        <Label fx:id="pendingTasksLabel"
                               text="0"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="3"/>

                        <Label text="Rejected Batches"
                               GridPane.rowIndex="2"/>
                        <Label fx:id="rejectedBatchLabel"
                               text="0"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                        <Label text="Production Efficiency"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="2"/>
                        <ProgressBar fx:id="efficiencyProgressBar"
                                     progress="0.0"
                                     prefWidth="250"
                                     GridPane.rowIndex="2"
                                     GridPane.columnIndex="3"/>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- REPORT TABLE -->

            <TitledPane text="Performance Details"
                        expanded="true"
                        collapsible="false"
                        VBox.vgrow="ALWAYS">

                <content>

                    <TableView fx:id="reportTable">

                        <columns>

                            <TableColumn fx:id="taskIdColumn"
                                         text="Task ID"
                                         prefWidth="120"/>

                            <TableColumn fx:id="mealCategoryColumn"
                                         text="Meal Category"
                                         prefWidth="180"/>

                            <TableColumn fx:id="teamColumn"
                                         text="Kitchen Team"
                                         prefWidth="180"/>

                            <TableColumn fx:id="preparedMealsColumn"
                                         text="Meals Prepared"
                                         prefWidth="150"/>

                            <TableColumn fx:id="completionColumn"
                                         text="Completion %"
                                         prefWidth="140"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Status"
                                         prefWidth="150"/>

                            <TableColumn fx:id="productionTimeColumn"
                                         text="Production Time"
                                         prefWidth="180"/>

                            <TableColumn fx:id="remarksColumn"
                                         text="Remarks"
                                         prefWidth="250"/>

                        </columns>

                    </TableView>

                </content>

            </TitledPane>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-background-color:#ECF0F1;">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Button text="Export PDF"
                    fx:id="exportPdfButton"
                    prefWidth="140"
                    onAction="#exportPDF"
                    style="-fx-background-color:#8E44AD;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Print Report"
                    fx:id="printButton"
                    prefWidth="140"
                    onAction="#printReport"
                    style="-fx-background-color:#2980B9;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Refresh"
                    fx:id="refreshButton"
                    prefWidth="120"
                    onAction="#refreshReport"
                    style="-fx-background-color:#16A085;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="120"
                    onAction="#goBack"
                    style="-fx-background-color:#E74C3C;-fx-text-fill:white;-fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>