<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1280"
            prefHeight="820"
            fx:controller="main.airport_catering_service.controller.headchef.ManageMealPreparationController">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to right,#8E44AD,#5B2C6F);">

            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="🍳 Manage Meal Preparation">
                <font>
                    <Font size="30"/>
                </font>
                <style>
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                </style>
            </Label>

            <Label text="Start and monitor meal preparation for production tasks.">
                <style>
                    -fx-text-fill:white;
                    -fx-font-size:15;
                </style>
            </Label>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Preparation Form -->

            <TitledPane text="Meal Preparation Details"
                        collapsible="false"
                        expanded="true">

                <content>

                    <GridPane hgap="20" vgap="18">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Production Task ID"/>
                        <TextField fx:id="taskIdField"
                                   promptText="Enter Production Task ID"
                                   prefWidth="250"
                                   GridPane.columnIndex="1"/>

                        <Label text="Preparation Status"
                               GridPane.columnIndex="2"/>

                        <ComboBox fx:id="statusComboBox"
                                  promptText="Select Status"
                                  prefWidth="220"
                                  GridPane.columnIndex="3"/>

                        <Label text="Preparation Instructions"
                               GridPane.rowIndex="1"/>

                        <TextArea fx:id="instructionTextArea"
                                  promptText="Enter cooking/preparation instructions..."
                                  prefHeight="120"
                                  prefWidth="450"
                                  wrapText="true"
                                  GridPane.rowIndex="1"
                                  GridPane.columnIndex="1"
                                  GridPane.columnSpan="3"/>

                        <Label text="Special Requirements"
                               GridPane.rowIndex="2"/>

                        <TextArea fx:id="specialRequirementTextArea"
                                  promptText="Vegetarian, Halal, Allergy, etc."
                                  prefHeight="90"
                                  wrapText="true"
                                  GridPane.rowIndex="2"
                                  GridPane.columnIndex="1"
                                  GridPane.columnSpan="3"/>

                        <HBox spacing="15"
                              GridPane.rowIndex="3"
                              GridPane.columnIndex="1"
                              GridPane.columnSpan="3">

                            <Button text="Start Preparation"
                                    fx:id="startPreparationButton"
                                    prefWidth="170"
                                    onAction="#startPreparation"
                                    style="-fx-background-color:#27AE60;-fx-text-fill:white;-fx-font-weight:bold;"/>

                            <Button text="Update Status"
                                    fx:id="updateStatusButton"
                                    prefWidth="150"
                                    onAction="#updatePreparationStatus"
                                    style="-fx-background-color:#3498DB;-fx-text-fill:white;-fx-font-weight:bold;"/>

                            <Button text="Clear"
                                    fx:id="clearButton"
                                    prefWidth="120"
                                    onAction="#clearForm"
                                    style="-fx-background-color:#95A5A6;-fx-text-fill:white;"/>

                        </HBox>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- Progress Table -->

            <TitledPane text="Preparation Progress"
                        collapsible="false"
                        expanded="true"
                        VBox.vgrow="ALWAYS">

                <content>

                    <TableView fx:id="preparationTable">

                        <columns>

                            <TableColumn fx:id="taskIdColumn"
                                         text="Task ID"
                                         prefWidth="120"/>

                            <TableColumn fx:id="mealCategoryColumn"
                                         text="Meal Category"
                                         prefWidth="220"/>

                            <TableColumn fx:id="assignedTeamColumn"
                                         text="Assigned Team"
                                         prefWidth="200"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Preparation Status"
                                         prefWidth="220"/>

                            <TableColumn fx:id="remarksColumn"
                                         text="Remarks"
                                         prefWidth="350"/>

                        </columns>

                    </TableView>

                </content>

            </TitledPane>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-background-color:#ECF0F1;">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button text="Refresh"
                    fx:id="refreshButton"
                    prefWidth="120"
                    onAction="#refreshTable"
                    style="-fx-background-color:#16A085;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="120"
                    onAction="#goBack"
                    style="-fx-background-color:#E74C3C;-fx-text-fill:white;-fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>