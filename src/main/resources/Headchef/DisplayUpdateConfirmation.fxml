<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1280"
            prefHeight="820"
            fx:controller="main.airport_catering_service.controller.headchef.RequestQualityInspectionController">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to right,#145A32,#27AE60);">

            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="🧪 Request Quality Inspection">
                <font>
                    <Font size="30"/>
                </font>
                <style>
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                </style>
            </Label>

            <Label text="Submit completed production batches for quality inspection.">
                <style>
                    -fx-text-fill:white;
                    -fx-font-size:15;
                </style>
            </Label>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Inspection Request Form -->

            <TitledPane text="Inspection Request"
                        collapsible="false"
                        expanded="true">

                <content>

                    <GridPane hgap="20" vgap="18">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Production Task ID"/>
                        <TextField fx:id="taskIdField"
                                   promptText="Enter Production Task ID"
                                   prefWidth="220"
                                   GridPane.columnIndex="1"/>

                        <Button text="Load Task"
                                fx:id="loadTaskButton"
                                prefWidth="120"
                                onAction="#loadTask"
                                style="-fx-background-color:#2980B9;-fx-text-fill:white;-fx-font-weight:bold;"
                                GridPane.columnIndex="2"/>

                        <Label text="Meal Category"
                               GridPane.rowIndex="1"/>
                        <TextField fx:id="mealCategoryField"
                                   editable="false"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <Label text="Inspection Priority"
                               GridPane.rowIndex="2"/>
                        <ComboBox fx:id="priorityComboBox"
                                  promptText="Select Priority"
                                  prefWidth="220"
                                  GridPane.rowIndex="2"
                                  GridPane.columnIndex="1"/>

                        <Label text="Preferred Inspection Time"
                               GridPane.rowIndex="3"/>
                        <DatePicker fx:id="inspectionDatePicker"
                                    GridPane.rowIndex="3"
                                    GridPane.columnIndex="1"/>

                        <Label text="Remarks"
                               GridPane.rowIndex="4"/>
                        <TextArea fx:id="remarksTextArea"
                                  promptText="Additional notes for Quality Inspector..."
                                  wrapText="true"
                                  prefHeight="120"
                                  GridPane.rowIndex="4"
                                  GridPane.columnIndex="1"
                                  GridPane.columnSpan="2"/>

                        <HBox spacing="15"
                              GridPane.rowIndex="5"
                              GridPane.columnIndex="1">

                            <Button text="Submit Request"
                                    fx:id="submitButton"
                                    prefWidth="160"
                                    onAction="#submitInspectionRequest"
                                    style="-fx-background-color:#27AE60;-fx-text-fill:white;-fx-font-weight:bold;"/>

                            <Button text="Reset"
                                    fx:id="resetButton"
                                    prefWidth="120"
                                    onAction="#resetForm"
                                    style="-fx-background-color:#F39C12;-fx-text-fill:white;-fx-font-weight:bold;"/>

                        </HBox>

                    </GridPane>

                </content>

            </TitledPane>

            <!-- Inspection Requests -->

            <TitledPane text="Inspection Request History"
                        collapsible="false"
                        expanded="true"
                        VBox.vgrow="ALWAYS">

                <content>

                    <TableView fx:id="inspectionTable">

                        <columns>

                            <TableColumn fx:id="requestIdColumn"
                                         text="Request ID"
                                         prefWidth="130"/>

                            <TableColumn fx:id="taskIdColumn"
                                         text="Task ID"
                                         prefWidth="120"/>

                            <TableColumn fx:id="mealCategoryColumn"
                                         text="Meal Category"
                                         prefWidth="170"/>

                            <TableColumn fx:id="priorityColumn"
                                         text="Priority"
                                         prefWidth="130"/>

                            <TableColumn fx:id="requestDateColumn"
                                         text="Request Date"
                                         prefWidth="180"/>

                            <TableColumn fx:id="inspectionStatusColumn"
                                         text="Inspection Status"
                                         prefWidth="180"/>

                            <TableColumn fx:id="remarksColumn"
                                         text="Remarks"
                                         prefWidth="280"/>

                        </columns>

                    </TableView>

                </content>

            </TitledPane>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-background-color:#ECF0F1;">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button text="Refresh"
                    fx:id="refreshButton"
                    prefWidth="120"
                    onAction="#refreshTable"
                    style="-fx-background-color:#16A085;-fx-text-fill:white;-fx-font-weight:bold;"/>

            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="120"
                    onAction="#goBack"
                    style="-fx-background-color:#E74C3C;-fx-text-fill:white;-fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>